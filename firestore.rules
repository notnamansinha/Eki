rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return hasCurrentRole('admin');
    }

    // Missing migration state, stale versions and interrupted publications
    // fail closed. Only the backend may write authorization state or roles.
    function hasCurrentRole(role) {
      return isAuthenticated() && request.auth.token.role == role &&
        request.auth.token.authorizationVersion is string &&
        get(/databases/$(database)/documents/_userAuthorization/$(request.auth.uid)).data.version == request.auth.token.authorizationVersion &&
        get(/databases/$(database)/documents/_userAuthorization/$(request.auth.uid)).data.role == role &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAssignedDriver(driverId, busId) {
      return hasCurrentRole('driver') &&
        request.auth.token.driverId == driverId &&
        request.auth.token.assignedBusId == busId && busId is string &&
        get(/databases/$(database)/documents/_userAuthorization/$(request.auth.uid)).data.driverId == driverId &&
        get(/databases/$(database)/documents/_userAuthorization/$(request.auth.uid)).data.assignedBusId == busId &&
        get(/databases/$(database)/documents/drivers/$(driverId)).data.authUid == request.auth.uid &&
        get(/databases/$(database)/documents/drivers/$(driverId)).data.assignedBusId == busId;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/ride_sessions/$(sessionId));
    }

    // Authentication short-circuits BEFORE the session fetch: a denied
    // unauthenticated read must never evaluate the billable get() (rule
    // ordering, audit #113). The driver branch gates sessionDoc() behind
    // isAuthenticated() && role checks via &&, which short-circuits.
    function isSessionOperator(sessionId) {
      return isAdmin() ||
        (isAuthenticated() && request.auth.token.role == 'driver' &&
         isAssignedDriver(sessionDoc(sessionId).data.driverId, sessionDoc(sessionId).data.busId));
    }

    // Operator OR passenger membership with a single session get(). A retained
    // historical manifest cannot authorize a passenger whose profile is gone.
    // Authentication is evaluated BEFORE the session fetch (audit #112): a
    // denied unauthenticated read must never evaluate the billable get().
    function canReadSession(sessionId) {
      return isAdmin() ||
        (isAuthenticated() &&
         ((request.auth.token.role == 'driver' &&
           isAssignedDriver(sessionDoc(sessionId).data.driverId, sessionDoc(sessionId).data.busId)) ||
          (sessionDoc(sessionId).data.passengers is map &&
           request.auth.uid in sessionDoc(sessionId).data.passengers &&
           sessionDoc(sessionId).data.passengers[request.auth.uid].userId == request.auth.uid &&
           exists(/databases/$(database)/documents/users/$(request.auth.uid)))));
    }

    // SEC: Boarding is server-issued (POST /api/sessions/:sessionId/join).
    // The passenger must present the assigned driver's non-public session code;
    // fresh hardware/browser proximity is an additional defense-in-depth check.
    // Chat rate limiting and feedback cooldowns are enforced server-side in
    // the matching Express endpoints; the rules simply deny client writes.

    // ── User Profiles — Store User Data & Roles ──
    match /users/{uid} {
      // Users can read their own profile
      allow read: if isOwner(uid);
      // Profile creation is backend-authoritative (POST /api/users/bootstrap).
      // The backend always creates profiles as role 'passenger' and never
      // overwrites an existing role, so clients cannot self-escalate.
      allow create: if false;
      allow update, delete: if false;
    }

    // ── Routes collection — authenticated read, write by admins only ──
    match /routes/{routeId} {
      allow read: if isAuthenticated();
      // Route geometry and stop validation are enforced by the admin API.
      allow create, update, delete: if false;
    }

    // ── Bus locations — admin read, backend-owned fleet projection ──
    match /bus_locations/{busId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // passenger_requests is backend-authoritative: no client rule block. The
    // admin /api/requests route manages lifecycle via the Admin SDK (issues
    // #72 + #73 removed the dead client create/transition surface).

    // ── Buses collection ──
    match /buses/{busId} {
      allow read: if isAuthenticated();
      // Fleet writes also update Auth claims and RTDB authorization mirrors.
      allow create, update, delete: if false;
    }

    // ── Ride Sessions ──
    match /ride_sessions/{sessionId} {
      // Passenger manifests contain personal travel information. Only trusted
      // operator roles may read them.
      allow read: if isSessionOperator(sessionId);
      // Session lifecycle, stop history AND passenger manifests are all
      // backend-authoritative. Clients cannot write here at all: boarding is
      // issued by the backend only after a driver-visible session code and
      // fresh proximity checks (POST /api/sessions/:sessionId/join). This
      // closes the self-join gap where a public RTDB sessionId was sufficient.
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canReadSession(sessionId);
        // Message writes are backend-authoritative (POST /api/sessions/:id/messages).
        // The server enforces membership, the 60/hr rolling rate limit, the 3s
        // gap, and the profanity filter — none of which a crafted client could
        // bypass. The server also normalizes Unicode, catches common
        // obfuscation, and enforces short-burst limits. Clients only read.
        allow create, update, delete: if false;
      }

      // Clearing live chat retains an operator-only ride history copy.
      match /archivedMessages/{messageId} {
        allow read: if isSessionOperator(sessionId);
        allow create, update, delete: if false;
      }

      match /messageRateLimits/{uid} {
        // Read is permitted for the owner so the UI can reflect limits, but
        // writes are backend-only: the server maintains the rolling window.
        // The cheap ownership check runs before the session fetch.
        allow read: if isOwner(uid) && canReadSession(sessionId);
        allow create, update, delete: if false;
      }
    }

    // ── Drivers collection ──
    match /drivers/{driverId} {
      allow read: if isAdmin() ||
        (hasCurrentRole('driver') &&
         resource.data.authUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ── Completed trips collection ──
    match /completed_trips/{tripId} {
      allow read: if isAdmin();
      allow write: if false; // Only backend writes to this via Admin SDK
    }

    // ── Feedback collection ──
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      // Feedback writes are backend-authoritative (POST /api/feedback). The
      // server enforces the 24h cooldown, the ride/general shape, and ride
      // eligibility (manifest membership, completed session, matching
      // bus/driver). Clients only read via the admin panel.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Feedback cooldowns
    match /feedbackCooldowns/{uid} {
      allow read: if isOwner(uid);
      // Cooldown writes are backend-only: the server stamps lastSubmittedAt
      // atomically with the feedback it approves.
      allow create, update, delete: if false;
    }

    // ── Devices collection — server-side Admin SDK access only ──
    // Device secrets MUST never be readable by any client.
    // HTTPS ingestion uses the Admin SDK, which bypasses these rules. Devices
    // receive only an independent per-device HTTPS secret.
    match /devices/{deviceId} {
      allow read, write: if false;
    }

    match /_userAuthorization/{uid} {
      allow read, write: if false;
    }

    // Canonical active-ride recovery records are backend-only. Clients receive
    // their public projection from Realtime Database.
    match /active_rides/{rideId} {
      allow read, write: if false;
    }

    // Internal coordination/maintenance documents are Admin-SDK-only. These
    // explicit denials supplement Firestore's default deny for audit clarity.
    match /_active_bus_locks/{busId} {
      allow read, write: if false;
    }
    // Durable creation-key bindings survive session deletion.
    match /_ride_session_creation_keys/{keyHash} {
      allow read, write: if false;
    }
    match /_worker_leases/{leaseId} {
      allow read, write: if false;
    }
    match /_privacy_deletion_requests/{uid} {
      allow read, write: if false;
    }
    match /_fleet_operations/{operationId} {
      allow read, write: if false;
    }
    match /_route_geometry_previews/{operationId} {
      allow read, write: if false;
    }
    match /_fleet_reconciliation_jobs/{operationId} {
      allow read, write: if false;
    }
    match /_fleet_reconciliation_locks/{lockId} {
      allow read, write: if false;
    }
    match /_route_save_operations/{operationId} {
      allow read, write: if false;
    }
    match /_health/{documentId} {
      allow read, write: if false;
    }
    match /_device_diagnostics/{deviceId} {
      allow read, write: if false;
    }

    // ── Settings collection ──
    match /settings/{document} {
      allow read: if isAuthenticated();
      // Settings writes are backend-authoritative (PUT /api/settings, admin
      // claim enforced server-side). Clients only read.
      allow create, update, delete: if false;
    }

    // ── Default deny — explicit catch-all (issue #49 L6) ──
    // Overlapping rules use OR semantics, so this never overrides a narrower
    // allow above; every collection not explicitly matched fails closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
