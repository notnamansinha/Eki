rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isDriver() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver' || isAdmin()
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function feedbackCooldownDoc(uid) {
      return /databases/$(database)/documents/feedbackCooldowns/$(uid);
    }

    function feedbackCooldownExpired(uid) {
      return !exists(feedbackCooldownDoc(uid)) ||
        request.time - get(feedbackCooldownDoc(uid)).data.lastSubmittedAt >= duration.value(5, 'm');
    }

    // ── User Profiles — Store User Data & Roles ──
    match /users/{uid} {
      // Users can read their own profile
      allow read: if isOwner(uid);
      // New users can only insert themselves as a 'passenger'
      allow create: if isOwner(uid) && request.resource.data.role == 'passenger';
      // Nobody can update/delete their own role (Forces Admin to do it manually in backend)
      allow update, delete: if false;
    }

    // ── Routes collection — PUBLIC read, write by admins only ──
    match /routes/{routeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Bus locations — PUBLIC read, write by drivers/admins ──
    match /bus_locations/{busId} {
      allow read: if true;
      allow write: if isDriver();
    }

    // ── Passenger requests — own requests for passengers, full access for drivers/admins ──
    match /passenger_requests/{requestId} {
      // Anyone authenticated can read their own requests (admins/drivers see all)
      allow read: if isAdmin() || isDriver() ||
        (isAuthenticated() && resource.data.passengerId == request.auth.uid);
      // Passengers can only create requests for themselves
      allow create: if isAuthenticated() &&
        request.resource.data.passengerId == request.auth.uid &&
        request.resource.data.lat is number &&
        request.resource.data.lng is number;
      // Only admins and drivers can update/delete requests
      allow update, delete: if isAdmin() || isDriver();
    }
    
    // ── Buses collection ──
    match /buses/{busId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ── Drivers collection ──
    match /drivers/{driverId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Completed trips collection ──
    match /completed_trips/{tripId} {
      allow read: if isAdmin();
      allow write: if false; // Only backend writes to this via Admin SDK
    }
    
    // ── Feedback collection ──
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'userId',
          'userName',
          'type',
          'busId',
          'driverId',
          'rating',
          'comment',
          'timestamp',
          'status'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userName is string &&
        request.resource.data.type in ['ride', 'general'] &&
        (request.resource.data.busId == null || request.resource.data.busId is string) &&
        (request.resource.data.driverId == null || request.resource.data.driverId is string) &&
        (request.resource.data.rating == null ||
          (request.resource.data.rating is number &&
            request.resource.data.rating >= 1 &&
            request.resource.data.rating <= 5)) &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 2000 &&
        request.resource.data.timestamp == request.time &&
        request.resource.data.status == 'new' &&
        feedbackCooldownExpired(request.auth.uid) &&
        getAfter(feedbackCooldownDoc(request.auth.uid)).data.lastSubmittedAt == request.time;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['new', 'reviewed', 'resolved'];
      allow delete: if false;
    }

    // Feedback cooldowns
    match /feedbackCooldowns/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['userId', 'lastSubmittedAt']) &&
        request.resource.data.userId == uid &&
        request.resource.data.lastSubmittedAt == request.time;
      allow update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['userId', 'lastSubmittedAt']) &&
        request.resource.data.userId == uid &&
        request.resource.data.lastSubmittedAt == request.time &&
        request.time - resource.data.lastSubmittedAt >= duration.value(5, 'm');
      allow delete: if false;
    }

    // ── Devices collection — server-side Admin SDK access only ──
    // Device secrets MUST never be readable by any client.
    // The backend POST /api/devices/auth uses Admin SDK which bypasses these rules,
    // but making the deny explicit prevents accidental misconfiguration.
    match /devices/{deviceId} {
      allow read, write: if false;
    }

    // ── Default deny — no catch-all, everything not listed above is denied ──
    // (Firestore denies by default, but this comment makes the intent explicit)
  }
}
