rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function feedbackCooldownDoc(uid) {
      return /databases/$(database)/documents/feedbackCooldowns/$(uid);
    }

    function feedbackCooldownExpired(uid) {
      let cooldownDoc = get(feedbackCooldownDoc(uid));
      return !exists(feedbackCooldownDoc(uid)) ||
             !('lastSubmittedAt' in cooldownDoc.data) ||
             request.time - cooldownDoc.data.lastSubmittedAt >= duration.value(24, 'h');
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/ride_sessions/$(sessionId));
    }

    function isSessionOperator(sessionId) {
      return isAdmin() ||
        (isAuthenticated() && request.auth.token.role == 'driver' &&
         request.auth.token.driverId == sessionDoc(sessionId).data.driverId);
    }

    function isSessionPassenger(sessionId) {
      let session = sessionDoc(sessionId);
      return isAuthenticated() && session.data.passengers is map &&
        request.auth.uid in session.data.passengers &&
        session.data.passengers[request.auth.uid].userId == request.auth.uid;
    }

    // SEC: Boarding is server-issued (POST /api/sessions/:sessionId/join)
    // after a proximity check against the hardware GNSS fix, so a passenger
    // cannot inject themselves into a session they are not physically on.
    function messageRateDoc(sessionId, uid) {
      return /databases/$(database)/documents/ride_sessions/$(sessionId)/messageRateLimits/$(uid);
    }

    function messageRateShapeValid(after) {
      return after.data.keys().hasOnly(['userId', 'sentAt', 'lastSentAt']) &&
        after.data.userId == request.auth.uid &&
        after.data.sentAt is list &&
        after.data.sentAt.size() <= 59 &&
        after.data.lastSentAt == request.time;
    }

    function rollingMessageRateAdvanced(before, after) {
      let previous = before.data.sentAt.concat([before.data.lastSentAt]);
      return before.data.keys().hasOnly(['userId', 'sentAt', 'lastSentAt']) &&
        before.data.userId == request.auth.uid &&
        before.data.sentAt is list &&
        before.data.sentAt.size() <= 59 &&
        after.data.sentAt is list &&
        request.time - before.data.lastSentAt >= duration.value(3, 's') &&
        (
          previous.size() < 60 &&
          after.data.sentAt == previous
        ||
          previous.size() == 60 &&
          request.time - previous[0] >= duration.value(1, 'h') &&
          after.data.sentAt == previous[1:60]
        );
    }

    function legacyMessageRateAdvanced(before, after) {
      return before.data.keys().hasOnly(['userId', 'windowStartedAt', 'lastSentAt', 'count']) &&
        before.data.userId == request.auth.uid &&
        before.data.count is int &&
        before.data.count >= 1 &&
        before.data.count <= 60 &&
        request.time - before.data.lastSentAt >= duration.value(3, 's') &&
        (
          request.time - before.data.windowStartedAt >= duration.value(1, 'h') &&
          after.data.sentAt.size() == 0
        ||
          request.time - before.data.windowStartedAt < duration.value(1, 'h') &&
          before.data.count < 60 &&
          after.data.sentAt.size() == before.data.count &&
          after.data.sentAt[0:before.data.count - 1].hasOnly([before.data.windowStartedAt]) &&
          after.data.sentAt[before.data.count - 1] == before.data.lastSentAt
        );
    }

    function messageRateAdvanced(sessionId) {
      let before = get(messageRateDoc(sessionId, request.auth.uid));
      let after = getAfter(messageRateDoc(sessionId, request.auth.uid));
      return messageRateShapeValid(after) &&
        (
          !exists(messageRateDoc(sessionId, request.auth.uid))
        ||
          exists(messageRateDoc(sessionId, request.auth.uid)) &&
          (
            rollingMessageRateAdvanced(before, after)
          ||
            legacyMessageRateAdvanced(before, after)
          )
        );
    }

    // ── User Profiles — Store User Data & Roles ──
    match /users/{uid} {
      // Users can read their own profile
      allow read: if isOwner(uid);
      // New users can only insert themselves as a 'passenger'
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.email is string && request.resource.data.email.size() <= 320 &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100 &&
        request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048 &&
        request.resource.data.role == 'passenger' &&
        request.resource.data.createdAt is number;
      // Nobody can update/delete their own role (Forces Admin to do it manually in backend)
      allow update, delete: if false;
    }

    // ── Routes collection — PUBLIC read, write by admins only ──
    match /routes/{routeId} {
      allow read: if isAuthenticated();
      // Route geometry and stop validation are enforced by the admin API.
      allow create, update, delete: if false;
    }

    // ── Bus locations — PUBLIC read, write by drivers/admins ──
    match /bus_locations/{busId} {
      allow read, write: if isAdmin();
    }

    // ── Passenger requests — own requests for passengers, full access for drivers/admins ──
    match /passenger_requests/{requestId} {
      // Anyone authenticated can read their own requests (admins/drivers see all)
      allow read: if isAdmin() ||
        (isAuthenticated() && request.auth.token.role == 'driver' &&
         resource.data.busId == request.auth.token.assignedBusId) ||
        (isAuthenticated() && resource.data.passengerId == request.auth.uid);
      // Passengers can only create requests for themselves
      allow create: if isAuthenticated() &&
        requestId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'passengerId', 'busId', 'type', 'lat', 'lng', 'status', 'createdAt'
        ]) &&
        request.resource.data.passengerId == request.auth.uid &&
        request.resource.data.busId is string && request.resource.data.busId.size() <= 128 &&
        request.resource.data.type in ['pickup', 'dropoff'] &&
        request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90 &&
        request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
      // Drivers may only transition status; immutable passenger/location fields
      // cannot be replaced through a broad document update.
      allow update: if isAdmin() ||
        (isAuthenticated() && request.auth.token.role == 'driver' &&
         resource.data.busId == request.auth.token.assignedBusId &&
         request.resource.data.busId == resource.data.busId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         request.resource.data.status in ['pending', 'accepted', 'completed', 'cancelled']);
      allow delete: if isAdmin() ||
        (isAuthenticated() && request.auth.token.role == 'driver' &&
         resource.data.busId == request.auth.token.assignedBusId);
    }
    
    // ── Buses collection ──
    match /buses/{busId} {
      allow read: if isAuthenticated();
      // Fleet writes also update Auth claims and RTDB authorization mirrors.
      allow create, update, delete: if false;
    }
    
    // ── Ride Sessions ──
    match /ride_sessions/{sessionId} {
      // Passenger manifests contain personal travel information. Only trusted
      // operator roles may read them.
      allow read: if isSessionOperator(sessionId);
      // Session lifecycle, stop history AND passenger manifests are all
      // backend-authoritative. Clients cannot write here at all: boarding is
      // issued by the backend only after a proximity check against the
      // hardware GNSS fix (POST /api/sessions/:sessionId/join). This closes
      // the self-join gap where any signed-in user could inject themselves
      // into any active session via its public RTDB sessionId.
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSessionOperator(sessionId) || isSessionPassenger(sessionId);
        allow create: if (isSessionOperator(sessionId) || isSessionPassenger(sessionId)) &&
          request.resource.data.keys().hasOnly(['text', 'from', 'senderName', 'senderId', 'timestamp']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 500 &&
          request.resource.data.senderName is string && request.resource.data.senderName.size() > 0 &&
          request.resource.data.senderName.size() <= 100 &&
          (
            (isSessionOperator(sessionId) && request.resource.data.from == 'driver') ||
            (isSessionPassenger(sessionId) && request.resource.data.from == 'passenger')
          ) &&
          request.resource.data.timestamp == request.time &&
          messageRateAdvanced(sessionId);
        allow update, delete: if false;
      }

      match /messageRateLimits/{uid} {
        allow read: if isOwner(uid) &&
          (isSessionOperator(sessionId) || isSessionPassenger(sessionId));
        allow create: if isOwner(uid) &&
          (isSessionOperator(sessionId) || isSessionPassenger(sessionId)) &&
          messageRateShapeValid(request.resource) &&
          request.resource.data.sentAt.size() == 0;
        allow update: if isOwner(uid) &&
          (isSessionOperator(sessionId) || isSessionPassenger(sessionId)) &&
          resource.data.userId == uid &&
          request.resource.data.userId == uid &&
          messageRateShapeValid(request.resource) &&
          (
            rollingMessageRateAdvanced(resource, request.resource)
          ||
            legacyMessageRateAdvanced(resource, request.resource)
          );
        allow delete: if false;
      }
    }
    
    // ── Drivers collection ──
    match /drivers/{driverId} {
      allow read: if isAdmin() ||
        (isAuthenticated() &&
         request.auth.token.role == 'driver' &&
         resource.data.authUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ── Completed trips collection ──
    match /completed_trips/{tripId} {
      allow read: if isAdmin();
      allow write: if false; // Only backend writes to this via Admin SDK
    }
    
    // ── Feedback collection ──
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'userId',
          'userName',
          'type',
          'sessionId',
          'busId',
          'driverId',
          'rating',
          'comment',
          'timestamp',
          'status'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userName is string && request.resource.data.userName.size() > 0 &&
        request.resource.data.userName.size() <= 100 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 2000 &&
        (
          (
            request.resource.data.type == 'general' &&
            request.resource.data.sessionId == null &&
            request.resource.data.busId == null &&
            request.resource.data.driverId == null &&
            request.resource.data.rating == null &&
            request.resource.data.comment.size() > 0
          ) ||
          (
            request.resource.data.type == 'ride' &&
            request.resource.data.sessionId is string &&
            request.resource.data.sessionId.size() > 0 &&
            request.resource.data.sessionId.size() <= 128 &&
            request.resource.data.busId is string &&
            request.resource.data.busId.size() > 0 &&
            request.resource.data.busId.size() <= 128 &&
            request.resource.data.driverId is string &&
            request.resource.data.driverId.size() > 0 &&
            request.resource.data.driverId.size() <= 128 &&
            (request.resource.data.rating == null ||
              (request.resource.data.rating is int &&
               request.resource.data.rating >= 1 &&
               request.resource.data.rating <= 5)) &&
            (request.resource.data.rating != null || request.resource.data.comment.size() > 0) &&
            isSessionPassenger(request.resource.data.sessionId) &&
            sessionDoc(request.resource.data.sessionId).data.status == 'completed' &&
            sessionDoc(request.resource.data.sessionId).data.busId == request.resource.data.busId &&
            sessionDoc(request.resource.data.sessionId).data.driverId == request.resource.data.driverId
          )
        ) &&
        request.resource.data.timestamp == request.time &&
        request.resource.data.status == 'new' &&
        feedbackCooldownExpired(request.auth.uid) &&
        getAfter(feedbackCooldownDoc(request.auth.uid)).data.lastSubmittedAt == request.time;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['new', 'reviewed', 'resolved'];
      allow delete: if false;
    }

    // Feedback cooldowns
    match /feedbackCooldowns/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['userId', 'lastSubmittedAt']) &&
        request.resource.data.userId == uid &&
        request.resource.data.lastSubmittedAt == request.time;
      allow update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['userId', 'lastSubmittedAt']) &&
        request.resource.data.userId == uid &&
        request.resource.data.lastSubmittedAt == request.time &&
        request.time - resource.data.lastSubmittedAt >= duration.value(24, 'h');
      allow delete: if false;
    }

    // ── Devices collection — server-side Admin SDK access only ──
    // Device secrets MUST never be readable by any client.
    // HTTPS ingestion uses the Admin SDK, which bypasses these rules. Devices
    // receive only an independent per-device HTTPS secret.
    match /devices/{deviceId} {
      allow read, write: if false;
    }

    // Canonical active-ride recovery records are backend-only. Clients receive
    // their public projection from Realtime Database.
    match /active_rides/{rideId} {
      allow read, write: if false;
    }

    // ── Settings collection ──
    match /settings/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ── Default deny — no catch-all, everything not listed above is denied ──
    // (Firestore denies by default, but this comment makes the intent explicit)
  }
}
