{
  "rules": {
    ".read": false,
    ".write": false,
    "activeBuses": {
      ".read": false,
      ".write": false,
      ".indexOn": ["routeId", "busId"],
      "$busKey": {
        ".write": false
      }
    },
    "activeRouteGeometry": {
      ".read": "auth != null",
      ".write": false
    },
    "publicRouteBuses": {
      ".read": "auth != null && (auth.token.admin == true || auth.token.role == 'admin')",
      ".write": false,
      "$routeId": {
        "buses": { ".read": "auth != null", ".write": false }
      }
    },
    "liveRouteCatalog": {
      ".write": false,
      "values": { ".read": "auth != null" }
    },
    "_deviceRateLimits": {
      ".read": false,
      ".write": false
    },
    "_deviceCredentialVersions": {
      ".read": false,
      ".write": false
    }
  }
}
