{
  "rules": {
    ".read": false,
    ".write": false,
    "activeBuses": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["routeId", "busId"],
      "$busKey": {
        ".write": false
      }
    },
    "driverRouteAssignments": {
      ".read": false,
      ".write": false
    },
    "messages": {
      ".read": false,
      ".write": false
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
