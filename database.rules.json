{
  "rules": {
    ".read": false,
    ".write": false,
    "activeBuses": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["routeId", "busId"],
      "$busKey": {
        ".write": false
      }
    },
    "_deviceRateLimits": {
      ".read": false,
      ".write": false
    },
    "_deviceCredentialVersions": {
      ".read": false,
      ".write": false
    }
  }
}
