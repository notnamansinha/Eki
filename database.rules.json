{
  "rules": {
    "activeBuses": {
      ".read": "auth != null",
      ".indexOn": ["routeId"],
      "$busKey": {
        ".write": "auth != null"
      }
    },
    "messages": {
      "$busId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
