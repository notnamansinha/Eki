+import { describe, expect, it } from "vitest";
+import { liveBusRetryDelayMs } from "./liveBusRetry";
+
+describe("liveBusRetryDelayMs", () => {
+  it("backs off from one second and caps at thirty seconds", () => {
+    expect([0, 1, 2, 3, 4, 5, 20].map(liveBusRetryDelayMs)).toEqual([
+      1_000, 2_000, 4_000, 8_000, 16_000, 30_000, 30_000,
+    ]);
+  });
+});
diff --git a/frontend/src/lib/liveBusRetry.ts b/frontend/src/lib/liveBusRetry.ts
new file mode 100644
index 0000000..cdc27eb
--- /dev/null
+++ b/frontend/src/lib/liveBusRetry.ts
@@ -0,0 +1,7 @@
+const INITIAL_RETRY_MS = 1_000;
+const MAX_RETRY_MS = 30_000;
+
+export function liveBusRetryDelayMs(attempt: number): number {
+  const exponent = Math.max(0, Math.min(attempt, 5));
+  return Math.min(MAX_RETRY_MS, INITIAL_RETRY_MS * (2 ** exponent));
+}
