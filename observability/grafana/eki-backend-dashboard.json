      "targets": [{ "expr": "min(eki_dependency_ready{service_name=\"eki-backend\"})", "legendFormat": "all dependencies", "refId": "A" }],
      "title": "Firebase readiness",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$prometheus" },
