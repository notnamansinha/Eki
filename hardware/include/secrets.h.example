#pragma once

// ── WiFi Credentials ──────────────────────────────────────────────
#define WIFI_SSID "YOUR_HOTSPOT_SSID"
#define WIFI_PASS "YOUR_HOTSPOT_PASSWORD"

// ── Firebase Configuration ────────────────────────────────────────
#define FIREBASE_HOST "bustrack-be165-default-rtdb.firebaseio.com"
#define FIREBASE_API_KEY "YOUR_FIREBASE_API_KEY"

#define BUS_ID "bus_01"
#define ROUTE_ID "route_01"
#define DRIVER_ID "hw_device"

// ── Backend Authentication ────────────────────────────────────────
// URL of the backend server that mints the Firebase custom token for this device.
// HTTPS is mandatory because this request carries the device credential.
#define BACKEND_URL "https://your-backend.example.com"

// PEM root certificate for the CA that issued BACKEND_URL's certificate.
static const char BACKEND_ROOT_CA[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
REPLACE_WITH_YOUR_BACKEND_CA_CERTIFICATE
-----END CERTIFICATE-----
)EOF";

// The device secret configured in Firestore 'devices' collection for this bus
#define DEVICE_SECRET "YOUR_DEVICE_SECRET_HERE"
