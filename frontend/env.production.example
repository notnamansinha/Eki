# Copy these values into the production build environment. Do not rename this
# tracked template to a committed .env file.
# Public canonical frontend origin. Preview/staging builds should disable indexing.
NEXT_PUBLIC_SITE_URL=https://eki.your-university.example
NEXT_PUBLIC_SITE_INDEXING=true
NEXT_PUBLIC_FIREBASE_API_KEY=browser_key_restricted_to_your_host_and_firebase_apis
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace
NEXT_PUBLIC_FIREBASE_APP_ID=replace
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=replace
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=browser_key_restricted_to_your_host_and_maps_javascript_api
NEXT_PUBLIC_GOOGLE_MAP_ID=replace_with_cloud_console_map_id
NEXT_PUBLIC_BACKEND_URL=https://api.your-university.example
# Optional display/runtime tuning
NEXT_PUBLIC_SERVICE_TIME_ZONE=Asia/Kolkata
NEXT_PUBLIC_PASSENGER_BUS_START_TIME=8:00 am
NEXT_PUBLIC_BUS_EXPIRY_MS=300000
