PORT=8080
NODE_ENV=production
# Comma-separated exact origins. Never use "*" with credentialed requests.
CORS_ORIGIN=https://your-project.web.app,https://your-project.firebaseapp.com

# Firebase Service Account JSON (server-side only)
# Recommended for production: use Google Cloud Secret Manager or Workload Identity instead
# FIREBASE_SERVICE_ACCOUNT='{...}'

# Firebase Realtime Database URL (required for RTDB features -- no hardcoded fallback)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Google Maps API key -- SERVER key (restrict to server IP + Routes API in GCP Console)
# Keep this DIFFERENT from the NEXT_PUBLIC_GOOGLE_MAPS_API_KEY in the frontend
GOOGLE_MAPS_API_KEY=your_server_side_routes_api_key_here

# Remove stale bus records after this many milliseconds (minimum: 90000).
BUS_STALE_MS=300000

# Per-device accepted HTTPS requests per minute. The route also has a bounded
# IP limiter; production should add a WAF/edge limit.
HTTPS_DEVICE_RATE_PER_MINUTE=90

# Expected number of backend replicas behind the load balancer. Every
# in-memory rate limiter divides its budget by this factor, so N replicas
# enforce the same aggregate budget as one instance. Set it to
# the deployed replica count. It must not exceed the smallest in-process budget
# (currently 10/minute) or the service refuses to start rather than weakening
# that aggregate limit; use a shared distributed limiter beyond that scale.
# The edge load balancer/WAF remains the authoritative global rate limit.
# Default 1 (single instance).
RATE_LIMIT_SHARD_FACTOR=1

# Revocation checks remain enabled. This short cache removes duplicate Firebase
# Auth round trips during bursts of browser API actions (0 disables caching,
# maximum accepted value is 60000).
AUTH_REVOCATION_CACHE_MS=15000

# A Firestore lease makes background work single-leader across API instances.
WORKER_ENABLED=true
# Optional stable instance identifier; otherwise a UUID is generated per boot.
# WORKER_INSTANCE_ID=eki-backend-01
# Pending, armed, or active sessions with no activity for this many hours are
# durably ended early by the leader worker (minimum 1, default 12).
ABANDONED_RIDE_THRESHOLD_HOURS=12

# Data minimization defaults. University privacy/legal must approve these.
# Destructive cleanup is fail-safe and runs only when this value, after
# trimming whitespace and ignoring case, is "true".
RETENTION_SWEEPER_ENABLED=true
RIDE_SESSION_RETENTION_DAYS=90
FEEDBACK_RETENTION_DAYS=180
COMPLETED_TRIP_RETENTION_DAYS=180
OPERATION_LOG_RETENTION_DAYS=90
