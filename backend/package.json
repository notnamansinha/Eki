{
  "name": "bustrack-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BusTrack backend with Express, Firebase Admin, and route operations",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "seed": "tsx src/seed.ts",
    "sync-role-claims": "tsx src/syncRoleClaims.ts",
    "provision-device": "tsx src/provisionDevice.ts",
    "test": "vitest run src",
    "test:rules-integration": "vitest run src/rulesIntegration.test.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "8.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/node": "^20.14.0",
    "eslint": "^9.39.4",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.10"
  }
}
