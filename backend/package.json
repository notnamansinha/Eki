{
  "name": "bustrack-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BusTrack backend with Express, Firebase Admin, and route operations",
  "main": "dist/bootstrap.js",
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "build": "tsc",
    "start": "node dist/bootstrap.js",
    "lint": "eslint src --ext .ts",
    "seed": "tsx src/seed.ts",
    "sync-role-claims": "tsx src/syncRoleClaims.ts",
    "provision-device": "tsx src/provisionDevice.ts",
    "measure:rtdb": "tsx src/measureRtdbLatency.ts",
    "test": "vitest run src",
    "test:rules-integration": "vitest run src/rulesIntegration.test.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "8.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.1.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "eslint": "^9.39.4",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.10"
  }
}
