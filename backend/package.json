{
  "name": "bustrack-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BusTrack backend with Express, Firebase Admin, and route operations",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "seed": "tsx src/seed.ts",
    "sync-role-claims": "tsx src/syncRoleClaims.ts",
    "patch-stops": "tsx src/patch-stops.ts",
    "test": "vitest run src"
  },
  "dependencies": {
    "@google-cloud/firestore": "8.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.1.0",
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^20.14.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
